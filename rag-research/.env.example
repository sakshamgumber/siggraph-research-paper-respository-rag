# Jina AI API configuration
# Get your API key from https://jina.ai/api-dashboard/key-manager
JINA_API_KEY=

# Qdrant configuration
# For Qdrant Cloud: set QDRANT_URL to your cluster URL (e.g. https://xxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333)
# and leave QDRANT_PATH blank.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=data/qdrant_local
QDRANT_COLLECTION=research_chunks_jina_v5
QDRANT_API_KEY=

# Groq LLM configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
